# ════════════════════════════════════════════════════════════════════════════
# PRODUCTION env vars for the BACKEND (set these in Railway → service → Variables)
# Do NOT commit real values. This file is a checklist/template only.
# ════════════════════════════════════════════════════════════════════════════

# ── Database ── Railway Postgres provides this automatically as DATABASE_URL,
# but it gives a postgresql:// URL — our app needs the +asyncpg driver.
# Either set this manually using Railway's connection details, or map it.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DBNAME

# ── Redis ── Railway Redis provides REDIS_URL automatically.
REDIS_URL=redis://default:PASSWORD@HOST:PORT

# ── App / URLs ──────────────────────────────────────────────────────────────
APP_BASE_URL=https://vendorrecon.org
ALLOWED_ORIGINS=["https://vendorrecon.org","https://www.vendorrecon.org"]

# ── Security (generate fresh for production — do NOT reuse dev values) ──
SECRET_KEY=GENERATE_64_HEX_openssl_rand_hex_32
FILE_ENCRYPTION_KEY=GENERATE_BASE64_32_openssl_rand_base64_32

# ── Clerk (use PRODUCTION instance keys: pk_live_ / sk_live_) ──
CLERK_JWKS_URL=https://YOUR-PROD.clerk.accounts.dev/.well-known/jwks.json
CLERK_SECRET_KEY=sk_live_xxx

# ── File storage = Cloudflare R2 ──
STORAGE_BACKEND=s3
S3_BUCKET=vendorrecon-files
S3_ENDPOINT_URL=https://ACCOUNTID.r2.cloudflarestorage.com
AWS_ACCESS_KEY_ID=r2_access_key
AWS_SECRET_ACCESS_KEY=r2_secret_key
AWS_REGION=auto

# ── Email (Resend) ──
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=re_xxx
SMTP_FROM=VendorRecon <noreply@vendorrecon.org>
SMTP_USE_TLS=true

# ── Lemon Squeezy (Merchant of Record — remits VAT, pays out via Wise) ──
LEMONSQUEEZY_API_KEY=ls_xxx
LEMONSQUEEZY_STORE_ID=12345           # numeric store id
LEMONSQUEEZY_VARIANT_PRO=67890        # variant id of the monthly Pro plan
LEMONSQUEEZY_WEBHOOK_SECRET=your_webhook_signing_secret   # set when creating the webhook

# ── AI fallback (optional) ──
ANTHROPIC_API_KEY=sk-ant-xxx

# ── Plan limits ──
FREE_MONTHLY_RECON_LIMIT=5        # set 500 pre-launch, 5 once you have real users
