# Copy to .env and fill in real values before running.

# Database — async asyncpg driver
DATABASE_URL=postgresql+asyncpg://vendorrecon:changeme@db:5432/vendorrecon

# JWT — generate with: openssl rand -hex 32
SECRET_KEY=REPLACE_WITH_64_HEX_CHARS

# AES-256 file encryption key — generate with: openssl rand -base64 32
FILE_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTES

# Redis
REDIS_URL=redis://redis:6379

# Storage: "local" for dev, "s3" for production
STORAGE_BACKEND=local
LOCAL_UPLOAD_DIR=/tmp/vendorrecon/uploads

# S3 (only needed when STORAGE_BACKEND=s3)
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Anthropic (only needed as LLM fallback for hard PDFs)
ANTHROPIC_API_KEY=

# CORS
ALLOWED_ORIGINS=["http://localhost:3000"]
