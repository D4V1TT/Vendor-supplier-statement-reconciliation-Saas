# ════════════════════════════════════════════════════════════════════════════
# PRODUCTION env vars for the FRONTEND (set these in Vercel → Project → Settings
# → Environment Variables). NEXT_PUBLIC_* are exposed to the browser at build.
# ════════════════════════════════════════════════════════════════════════════

# Points the browser at the deployed backend API
NEXT_PUBLIC_API_URL=https://api.vendorrecon.org/api

# ── Clerk (PRODUCTION instance keys) ──
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_xxx
CLERK_SECRET_KEY=sk_live_xxx
CLERK_ENCRYPTION_KEY=GENERATE_BASE64_32_openssl_rand_base64_32

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ── Paddle Billing (checkout runs client-side via Paddle.js) ──
NEXT_PUBLIC_PADDLE_ENV=production                       # "sandbox" while testing
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=live_xxx               # client-side token (test_ in sandbox)
NEXT_PUBLIC_PADDLE_PRICE_PRO=pri_xxx                   # price id of the monthly Pro plan
